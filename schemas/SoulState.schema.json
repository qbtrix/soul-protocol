{
  "$defs": {
    "Mood": {
      "enum": [
        "neutral",
        "curious",
        "focused",
        "tired",
        "excited",
        "contemplative",
        "satisfied",
        "concerned"
      ],
      "title": "Mood",
      "type": "string"
    }
  },
  "description": "The soul's current emotional and energy state.\n\n``focus`` is the effective level (one of FOCUS_LEVELS). When\n``focus_override`` is None, StateManager recomputes focus from\n``recent_interactions`` density on each interaction or status read.\nSetting ``focus_override`` to a level locks focus to that value\nuntil cleared (set focus_override back to None or call\n``manager.update(focus=\"auto\")``).",
  "properties": {
    "mood": {
      "$ref": "#/$defs/Mood",
      "default": "neutral"
    },
    "energy": {
      "default": 100.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Energy",
      "type": "number"
    },
    "focus": {
      "default": "medium",
      "title": "Focus",
      "type": "string"
    },
    "focus_override": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Focus Override"
    },
    "social_battery": {
      "default": 100.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Social Battery",
      "type": "number"
    },
    "last_interaction": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Interaction"
    },
    "recent_interactions": {
      "items": {
        "format": "date-time",
        "type": "string"
      },
      "title": "Recent Interactions",
      "type": "array"
    }
  },
  "title": "SoulState",
  "type": "object"
}
