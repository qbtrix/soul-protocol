{
  "$defs": {
    "Bond": {
      "description": "The relationship between a human and their soul.",
      "properties": {
        "bonded_to": {
          "default": "",
          "title": "Bonded To",
          "type": "string"
        },
        "bonded_at": {
          "format": "date-time",
          "title": "Bonded At",
          "type": "string"
        },
        "bond_strength": {
          "default": 50.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Bond Strength",
          "type": "number"
        },
        "interaction_count": {
          "default": 0,
          "title": "Interaction Count",
          "type": "integer"
        }
      },
      "title": "Bond",
      "type": "object"
    },
    "BondTarget": {
      "description": "An entity this soul is bonded to.\n\nBond targets are portable \u2014 they travel with the soul across platforms.\nThe bond_type field classifies the relationship kind.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "bond_type": {
          "default": "human",
          "title": "Bond Type",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "BondTarget",
      "type": "object"
    }
  },
  "description": "A soul's unique identity with cryptographic DID.\n\nMulti-bond support: ``bonds`` holds a list of BondTarget entities.\nThe legacy ``bonded_to`` field is preserved for backward compatibility.\nOn model_post_init, if bonded_to is set and bonds is empty, bonds is\nauto-populated from bonded_to (migration path).",
  "properties": {
    "did": {
      "default": "",
      "title": "Did",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "archetype": {
      "default": "",
      "title": "Archetype",
      "type": "string"
    },
    "role": {
      "default": "",
      "title": "Role",
      "type": "string"
    },
    "born": {
      "format": "date-time",
      "title": "Born",
      "type": "string"
    },
    "bonded_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bonded To"
    },
    "bonds": {
      "items": {
        "$ref": "#/$defs/BondTarget"
      },
      "title": "Bonds",
      "type": "array"
    },
    "origin_story": {
      "default": "",
      "title": "Origin Story",
      "type": "string"
    },
    "prime_directive": {
      "default": "",
      "title": "Prime Directive",
      "type": "string"
    },
    "core_values": {
      "items": {
        "type": "string"
      },
      "title": "Core Values",
      "type": "array"
    },
    "bond": {
      "$ref": "#/$defs/Bond"
    },
    "incarnation": {
      "default": 1,
      "title": "Incarnation",
      "type": "integer"
    },
    "previous_lives": {
      "items": {
        "type": "string"
      },
      "title": "Previous Lives",
      "type": "array"
    }
  },
  "required": [
    "name"
  ],
  "title": "Identity",
  "type": "object"
}
